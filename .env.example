# Copy to .env and fill in your own credentials before starting the backend.
# Generate a dedicated API token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AML_AUTH_TOKEN=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# The default backend listens only on localhost.
MEMORYSHIELD_PORT=18080
# Optional paid reranking through DashScope.
AML_RERANK=false
